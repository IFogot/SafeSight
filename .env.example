# Public browser model configuration. The model must be an ONNX YOLO model
# exported with a [1, 3, inputSize, inputSize] image input and YOLO rows in
# either [1, 4+classes, boxes] or [1, boxes, 4+classes] output format.
NEXT_PUBLIC_YOLO_MODEL_URL=https://your-cdn.example.com/safesight-ppe.onnx
NEXT_PUBLIC_YOLO_LABELS=["person","helmet","no_helmet","vest","no_vest","gloves","no_gloves","boots","no_boots","goggles","no_goggles","hazard_zone","spill"]
NEXT_PUBLIC_YOLO_INPUT_SIZE=640
NEXT_PUBLIC_YOLO_CONFIDENCE=0.35
NEXT_PUBLIC_YOLO_IOU=0.45

# Server-side persistence
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
